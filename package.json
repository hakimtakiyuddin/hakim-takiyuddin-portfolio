    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "^8.0.3",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
